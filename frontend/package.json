{
  "name": "toolhub-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo-pages.mjs && vite build && node scripts/verify-seo-output.mjs",
    "seo:generate": "node scripts/generate-seo-pages.mjs --refresh",
    "seo:verify": "node scripts/verify-seo-output.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "axios": "^1.6.7",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.2",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
